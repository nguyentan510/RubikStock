{
  "name": "rubikstock",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "check": "powershell -ExecutionPolicy Bypass -File scripts/check.ps1",
    "smoke:api": "powershell -ExecutionPolicy Bypass -File scripts/smoke-api.ps1",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:lint": "npm --prefix apps/web run lint",
    "web:typecheck": "npm --prefix apps/web run typecheck"
  }
}
